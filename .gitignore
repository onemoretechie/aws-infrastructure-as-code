# Local .terraform directories
**/.terraform/*

# .tfstate files (state must live in S3, never in git)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
*.tfvars.json
!example.tfvars
!*.example.tfvars

# Plan output files
*.tfplan
*.tfplan.binary

# CLI configuration files
.terraformrc
terraform.rc

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lock info
.terraform.lock.info

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Credentials and secrets
*.pem
*.key
.env
.env.*
!.env.example
aws-credentials
